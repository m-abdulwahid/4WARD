# Gemini API key (Google AI Studio). Without it the bots use a deterministic rule-based planner.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# local = Playwright on this machine (works today). steel = Steel cloud browsers (Phase 5).
BROWSER_BACKEND=local
# Tiger Data (Postgres + TimescaleDB) connection string: the main database. Without it, or with REPLAY=1,
# the app falls back to local SQLite (offline mode only).
DATABASE_URL=
# Set to 1 to never hit the network (uses cached/recorded data)
REPLAY=0
NEXT_PUBLIC_API_URL=http://localhost:8000
STEEL_API_KEY=
