# Gemini API key (Google AI Studio). Without it the bots use a deterministic rule-based planner.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Tiger Data (Postgres + TimescaleDB) connection string. Without it the app uses local SQLite.
DATABASE_URL=
# Set to 1 to never hit the network (uses cached/recorded data)
REPLAY=0
NEXT_PUBLIC_API_URL=http://localhost:8000
