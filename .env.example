# Gemini API key (Google AI Studio). Without it the bots use a deterministic rule-based planner.
GEMINI_API_KEY=
# Use a model your key can call (gemini-2.5-flash is listed in some accounts but generate may 404).
GEMINI_MODEL=gemini-flash-latest
# local = Playwright on this machine (works today). steel = Steel cloud browsers (Phase 5).
BROWSER_BACKEND=local
# Tiger Data (Postgres + TimescaleDB) connection string: the main database. Without it, or with REPLAY=1,
# the app falls back to local SQLite (offline mode only).
DATABASE_URL=
# Set to 1 to never hit the network (uses cached/recorded data)
REPLAY=0
# Dashboard URL the API / bots should treat as the UI origin (local default).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public dashboard origin(s) for CORS (comma-separated). Local defaults if unset.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Shared secret for /run and /ws/run. Leave empty locally to disable the gate.
# In production set the same value as NEXT_PUBLIC_BOT_TOKEN on the dashboard host.
BOT_TOKEN=
NEXT_PUBLIC_BOT_TOKEN=
# Requests per IP per minute (0 = off). Default 120.
RATE_LIMIT_PER_MIN=120
# Background feed poll interval in seconds (0 = off inside the API process).
INGEST_EVERY_S=90
STEEL_API_KEY=
# TomTom Flow Segment Data (backend/tomtom.py): never stored, in-memory only, see backend/config.py.
TOMTOM_API_KEY=
# City of Toronto road restrictions feed (backend/road_restrictions.py): off by default, not yet
# wired into any route's timing. Set to "true" to fetch it (once a day, in memory only).
ROAD_RESTRICTIONS_ENABLED=false
